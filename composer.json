{
  "name": "vendor/catalog",
  "description": "Catalog test project with Bitrix-style module structure",
  "type": "project",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-pdo": "*",
    "ext-mbstring": "*",
    "predis/predis": "^2.2"
  },
  "autoload": {
    "psr-4": {
      "Vendor\\Catalog\\": "local/modules/vendor.catalog/lib/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}